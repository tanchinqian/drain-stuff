# Vite reads these at startup/build. Restart after edits.
# Set a reachable API prefix to prefer the backend; /config is probed once.
VITE_API_BASE=
# Optional: api (default if a base exists) | mock (force local storage).
VITE_DATA_SOURCE=api
# Optional: true | false. Unset defaults to true only for mock mode.
VITE_SHOW_DATA_NOTICE=
