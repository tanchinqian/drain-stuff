# Copy to .env.local for local use. dev:all creates a random operator token if absent.
OPERATOR_TOKEN=replace-with-a-random-token-at-least-24-characters
DB_PATH=data/drain.sqlite
PORT=8080
APP_PORT=5173
HOST=127.0.0.1
SEED_DEMO=0
# Comma-separated exact frontend origins; same-origin works without this setting.
CORS_ORIGIN=
# Stage A always uses deterministic retrieval; provider adapters arrive in Stage D.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
