# Copy to .env.local for local use. The demonstration requires no operator login.
DB_PATH=data/drain.sqlite
PORT=8080
APP_PORT=5173
HOST=127.0.0.1
SEED_DEMO=0
# Comma-separated exact frontend origins; same-origin works without this setting.
CORS_ORIGIN=
# Server-side part analysis. Missing key or provider errors use logged case matching.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=https://opencode.ai/inference/openai/v1
# Faults corner chatbot: local Ollama, separate from the part-diagnosis provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
# Separate integration credentials: real device vs simulator provenance is fixed by the server.
LORAWAN_INGEST_SECRET=
LORAWAN_SIM_SECRET=
