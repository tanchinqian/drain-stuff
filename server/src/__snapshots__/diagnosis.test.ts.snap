// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`prompt version loads and assembled evidence is stable and delimited 1`] = `
"<fault_evidence_json>
{"fault":{"id":"F-001","type":"blockage","part":"inlet","description":"Level history + visual inspection"},"sensors":[],"retrievedCases":[{"id":"CASE-INLET-2","assetType":"swale","part":"inlet","ruleId":"inlet_debris","symptoms":"Visible debris at the inlet; inspect access and arrange trained clearance.","cause":"Inlet debris","sourceLabel":"Guidance-based example","sourceUrl":"https://www.ashevillenc.gov/news/asheville-asks-how-does-stormwater-services-prepare-for-heavy-rain/","stepsTaken":["STEP-blockage-1","STEP-blockage-2","STEP-blockage-4"],"sensorFlags":[],"outcome":"Worked example only; no field outcome measured.","createdBy":"Sourced reference library"},{"id":"CASE-SOCK-2","assetType":"swale","part":"sock","ruleId":"inlet_debris","symptoms":"Filter sock sediment needs inspection and an appropriate material check.","cause":"Sock sediment accumulation","sourceLabel":"Guidance-based example","sourceUrl":"https://www.epa.gov/system/files/documents/2021-11/bmp-compost-filter-socks.pdf","stepsTaken":["STEP-sediment-1","STEP-sediment-2","STEP-sediment-4"],"sensorFlags":[],"outcome":"Worked example only; no field outcome measured.","createdBy":"Sourced reference library"},{"id":"CASE-INLET-1","assetType":"inlet","part":"inlet","ruleId":"inlet_debris","symptoms":"Leaves and litter obstruct a roadside inlet before rain.","cause":"Inlet debris","sourceLabel":"Guidance-based example","sourceUrl":"https://www.ashevillenc.gov/news/asheville-asks-how-does-stormwater-services-prepare-for-heavy-rain/","stepsTaken":["STEP-blockage-1","STEP-blockage-2","STEP-blockage-4","STEP-blockage-5"],"sensorFlags":[],"outcome":"Worked example only; no field outcome measured.","createdBy":"Sourced reference library"}],"retrievedGuidance":[{"id":"GUIDE-MN-GARDEN","title":"Rain garden maintenance","passage":"Inspect inlet obstruction, vegetation and excess soil. Avoid trampling and compacting the garden. Drainage concerns need a site-specific inspection.","sourceUrl":"https://stormwater.pca.state.mn.us/rain_gardens_bioretention_101","appliesTo":["inlet","media","planting","ponding"]},{"id":"GUIDE-ASHEVILLE","title":"Preparation before heavy rain","passage":"Municipal crews inspect vulnerable sites and clear debris from drains and known trouble areas, with equipment and staff coordination before heavy rain.","sourceUrl":"https://www.ashevillenc.gov/news/asheville-asks-how-does-stormwater-services-prepare-for-heavy-rain/","appliesTo":["inlet","outfall","pretreat"]},{"id":"GUIDE-EPA-SOCK","title":"Filter sock inspection and material suitability","passage":"Inspect accumulated sediment and the sock condition. Use mature, stable compost meeting applicable material requirements; the barrier is not a substitute for a safe overflow path.","sourceUrl":"https://www.epa.gov/system/files/documents/2021-11/bmp-compost-filter-socks.pdf","appliesTo":["sock","pretreat"]}],"allowedSteps":{"STEP-blockage-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-blockage-2":"Photograph the inlet and filter sock (the fabric bag that traps sediment); note the date and sensor reading.","STEP-blockage-3":"If rain is forecast within 24 hours, notify the owner of record and mark the inlet as restricted.","STEP-blockage-4":"The owner arranges trained clearing or sock replacement and sediment disposal under the local procedure.","STEP-blockage-5":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-sediment-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-sediment-2":"Photograph and record the depth of deposited sand or silt at the inlet and bed.","STEP-sediment-3":"Ask the owner to arrange removal without pushing the material into the downstream drain.","STEP-sediment-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-standing_water-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-standing_water-2":"Record when rain ended, how long water has remained and the current depth. Compare the elapsed time with the configured inspection period.","STEP-standing_water-3":"Ask the owner to inspect trapped sediment and the underdrain (the pipe below the soil that carries water away). Do not probe a blocked pipe yourself.","STEP-standing_water-4":"The owner arranges trained clearance or repair; keep the affected area restricted until checked.","STEP-standing_water-5":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-sensor_suspect-1":"Check the input ID, last reading time and calibration record before acting on its value.","STEP-sensor_suspect-2":"Ask the trained operator to compare it with a manual reference reading and check power, connections and placement without entering a chamber.","STEP-sensor_suspect-3":"Keep the input marked suspect or offline until the comparison and calibration are recorded. Do not treat a missing value as zero.","STEP-sensor_suspect-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-sensor_offline-1":"Check the input ID, last reading time and calibration record before acting on its value.","STEP-sensor_offline-2":"Ask the trained operator to compare it with a manual reference reading and check power, connections and placement without entering a chamber.","STEP-sensor_offline-3":"Keep the input marked suspect or offline until the comparison and calibration are recorded. Do not treat a missing value as zero.","STEP-sensor_offline-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-mulch_loss-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-mulch_loss-2":"Photograph bare areas and displaced mulch (the loose protective surface layer). Check whether rain moved it into an inlet.","STEP-mulch_loss-3":"Ask the owner to restore the approved mulch depth and secure the cause of washout. Keep loose material out of open drains.","STEP-mulch_loss-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-scour-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-scour-2":"Photograph channels cut into the soil by flowing water. Record nearby displaced material.","STEP-scour-3":"The owner arranges repair of the inlet flow spreader and eroded soil before replacing planting.","STEP-scour-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-sparse_planting-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-sparse_planting-2":"Photograph bare patches and note plant damage or dry soil.","STEP-sparse_planting-3":"The owner checks the cause and arranges suitable replacement planting without obstructing the drain.","STEP-sparse_planting-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-joint_leak-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-joint_leak-2":"Photograph visible leakage and note the water level without touching or entering the pipe.","STEP-joint_leak-3":"The owner arranges a trained check of the pipe joint and repair under the local procedure.","STEP-joint_leak-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-missing_cap-1":"Check from the surface in safe weather. Do not enter a chamber or lift a cover alone. Keep away from flowing water.","STEP-missing_cap-2":"Photograph the missing cap and keep people away from the opening.","STEP-missing_cap-3":"Ask the owner to fit the correct cap and inspect for material that entered the pipe.","STEP-missing_cap-4":"Record the photos, date, readings and work in the fault log. Arrange a manual check after the next rain; the console does not run field tests automatically.","STEP-not_heating-1":"Check the batch age and compare both pile temperature probes with the air reference. A cooling mature batch may not need heating.","STEP-not_heating-2":"Ask the operator to check moisture with the approved manual method and review the recorded mix of food and dry material.","STEP-not_heating-3":"The operator adjusts moisture or dry material and turns the pile only under the site procedure, then records follow-up temperatures.","STEP-not_heating-4":"Keep maturity and allocation gates in place; a temperature rise alone does not prove maturity.","STEP-too_wet-1":"Keep away from puddles and avoid direct contact with the material. Ask the operator to confirm the moisture proxy using the approved squeeze check and protective equipment.","STEP-too_wet-2":"Check the cover and whether rain or added water is entering the bay.","STEP-too_wet-3":"The operator adds suitable dry bulking material (coarse material that leaves air spaces) and mixes under the site procedure.","STEP-too_wet-4":"Record the action, manual check and follow-up moisture. Keep drainage to the collection sump clear.","STEP-putrid_smell-1":"Do not lean into the bay to smell it. Move away from strong odour and notify the operator.","STEP-putrid_smell-2":"Keep other people clear; the operator checks wetness, trapped liquid and the cover from a safe position.","STEP-putrid_smell-3":"A trained operator arranges aeration and dry bulking material under the site procedure; do not enter an enclosed space.","STEP-putrid_smell-4":"Record the observation and follow-up checks. No gas sensor or safe-air claim is provided by this console.","STEP-ammonia_smell-1":"Move away from strong odour; do not deliberately inhale it or lean into the pile. Notify the operator.","STEP-ammonia_smell-2":"The operator reviews the food input and dry-carbon mix and checks moisture with the approved method.","STEP-ammonia_smell-3":"The operator adjusts dry-carbon material under the site procedure, then records the change and follow-up observations.","STEP-ammonia_smell-4":"Keep the batch on hold pending the maturity checks. The smell log is a human observation, not a gas measurement.","STEP-pests-1":"Observe from a distance and photograph signs without handling pests or contaminated material.","STEP-pests-2":"Ask the operator to check exposed food, spilled inputs and gaps in the cover.","STEP-pests-3":"The operator removes spills, secures the cover and arranges approved pest management if activity persists.","STEP-pests-4":"Record the location and follow-up inspection; do not apply unapproved chemicals to compost.","STEP-leachate-1":"Leachate is liquid draining from compost. Avoid contact and keep people away from overflow.","STEP-leachate-2":"From the surface, photograph the cover, collection channel and sump; record recent rain and the level.","STEP-leachate-3":"Notify the owner to arrange containment, collection and disposal under the local procedure. Do not release it into a storm drain.","STEP-leachate-4":"The operator checks and repairs the cover or collection system, then records a post-rain check."}}
</fault_evidence_json>"
`;
